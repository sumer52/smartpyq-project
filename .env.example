# ==============================================================================
# SmartPYQ Backend Environment Configuration
# ==============================================================================
# Copy to .env for local development. NEVER commit .env.
# In production (Render), set these as environment variables in the dashboard
# — Render values always take precedence over any .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE
# ------------------------------------------------------------------------------
# Environment: development | test | production
ENV=development
DEBUG=false
# Server port (Render injects PORT automatically; the app binds 0.0.0.0:$PORT)
PORT=8000

# ------------------------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------------------------
# Local dev:     sqlite+aiosqlite:///./smartpyq.db
# Production:    postgresql+asyncpg://user:password@host:5432/smartpyq
#                (Render -> smartpyq-db -> "Internal Database URL")
DATABASE_URL=sqlite+aiosqlite:///./smartpyq.db

# ------------------------------------------------------------------------------
# SECURITY (required in production)
# ------------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be >= 32 chars in production or startup fails.
JWT_SECRET=
JWT_ACCESS_EXPIRE_SECONDS=86400
JWT_REFRESH_EXPIRE_SECONDS=2592000
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# CORS / HOSTS  (comma-separated, no spaces needed; never use "*" with credentials)
# ------------------------------------------------------------------------------
# Dev defaults:
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Additional explicit origins for the CORS middleware (e.g. Vercel domain):
CORS_ORIGINS=http://localhost:5173
# Frontend origin (used in emails/links):
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SUPABASE (private file storage ONLY — the app database stays on Render Postgres)
# ------------------------------------------------------------------------------
# Project URL: Supabase Dashboard -> Settings -> API
SUPABASE_URL=
# Public anon/publishable key (client-side safe; both names accepted)
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=        # alternative newer name
# SERVER-SIDE ONLY — never expose via VITE_* or commit. Both names accepted:
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=             # alternative newer name
SUPABASE_STORAGE_BUCKET=question-papers
# Enable Supabase private storage for uploads (dev may use local disk):
USE_SUPABASE_STORAGE=false

# ------------------------------------------------------------------------------
# AI SERVICES (optional — enables AI assistant features)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# EMAIL / SMTP (optional — enables email OTP)
# ------------------------------------------------------------------------------
SMTP_SERVER=localhost
# SMTP_HOST=                       # optional alias for SMTP_SERVER
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=noreply@smartpyq.com
FROM_NAME=Smart PYQ
SUPPORT_EMAIL=support@smartpyq.com
# Dev convenience: log OTP codes to the server console instead of emailing.
# MUST be false in production.
DEV_EMAIL_LOG_OTP=true

# ------------------------------------------------------------------------------
# DEMO ACCOUNT (optional)
# ------------------------------------------------------------------------------
# Default: enabled in development, DISABLED in production.
# Set true to expose the demo account (demo@smartpyq.com) in production.
ENABLE_DEMO_ACCOUNT=

# ------------------------------------------------------------------------------
# REDIS / CELERY (optional — not required for deployment)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# FILE STORAGE (local fallback — development only)
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,webp
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=http://localhost:8000/files
SIGNED_URL_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# MONITORING (optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# RATE LIMITING / CACHE / PAGINATION (sensible defaults)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
